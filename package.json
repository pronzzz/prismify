{
    "name": "prismify",
    "version": "5.0.0",
    "description": "Make code easier to read: scope-safe renames, formatting, doc comments and refactoring hints for JavaScript, TypeScript, Python and Java. Works offline, or with a local LLM via Ollama.",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "bin": {
        "prismify": "dist/cli.js"
    },
    "files": [
        "dist",
        "!dist/**/*.map",
        "README.md",
        "LICENSE",
        "CHANGELOG.md"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "dev": "tsx src/cli.ts",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit",
        "prepare": "npm run build",
        "prepublishOnly": "npm run typecheck && npm test"
    },
    "keywords": [
        "code-beautifier",
        "formatter",
        "refactoring",
        "rename",
        "clean-code",
        "readability",
        "ollama",
        "llm",
        "ai",
        "prettier",
        "python",
        "typescript",
        "java",
        "cli",
        "developer-tools"
    ],
    "author": "Pranav Dwivedi (https://github.com/pronzzz)",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/pronzzz/prismify.git"
    },
    "homepage": "https://github.com/pronzzz/prismify#readme",
    "bugs": {
        "url": "https://github.com/pronzzz/prismify/issues"
    },
    "dependencies": {
        "@babel/parser": "^7.29.11",
        "@babel/traverse": "^7.29.10",
        "@babel/types": "^7.29.11",
        "chalk": "^5.6.2",
        "commander": "^12.1.0",
        "diff": "^7.0.0",
        "ollama": "^0.5.18",
        "prettier": "^3.9.10",
        "prettier-plugin-java": "^2.11.0"
    },
    "devDependencies": {
        "@types/babel__traverse": "^7.28.0",
        "@types/diff": "^7.0.2",
        "@types/node": "^20.19.43",
        "tsx": "^4.23.15",
        "typescript": "~5.9",
        "vitest": "^3.2.7"
    },
    "engines": {
        "node": ">=20"
    }
}
