{
    "name": "prismify",
    "displayName": "Prismify",
    "description": "Readable code in one command: safe renames, formatting, doc comments and refactoring hints for JS, TS, Python and Java.",
    "version": "2.0.0",
    "publisher": "pronzzz",
    "engines": {
        "vscode": "^1.80.0"
    },
    "categories": [
        "Formatters",
        "Linters",
        "Other"
    ],
    "keywords": [
        "beautify",
        "format",
        "refactor",
        "ai",
        "rename",
        "clean code"
    ],
    "activationEvents": [],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "prismify.beautify",
                "title": "Beautify File (rename + format)",
                "category": "Prismify"
            },
            {
                "command": "prismify.format",
                "title": "Format File (no renames)",
                "category": "Prismify"
            },
            {
                "command": "prismify.explain",
                "title": "Add Doc Comments",
                "category": "Prismify"
            },
            {
                "command": "prismify.analyze",
                "title": "Show Refactoring Suggestions",
                "category": "Prismify"
            }
        ],
        "configuration": {
            "title": "Prismify",
            "properties": {
                "prismify.path": {
                    "type": "string",
                    "default": "",
                    "description": "Path to the prismify CLI. Empty: use the workspace's node_modules/.bin/prismify, then PATH."
                },
                "prismify.styleProfile": {
                    "type": "string",
                    "default": "",
                    "enum": [
                        "",
                        "google",
                        "airbnb",
                        "minimal",
                        "python",
                        "java",
                        "competitive"
                    ],
                    "description": "Style profile. Empty: the language default (or your .prismifyrc.json)."
                },
                "prismify.detectStyle": {
                    "type": "boolean",
                    "default": false,
                    "description": "Match each file's existing indentation, quotes and semicolons."
                },
                "prismify.provider": {
                    "type": "string",
                    "default": "auto",
                    "enum": [
                        "auto",
                        "ollama",
                        "heuristic"
                    ],
                    "description": "Naming provider. auto uses Ollama when it is running, otherwise offline heuristics."
                },
                "prismify.model": {
                    "type": "string",
                    "default": "",
                    "description": "Ollama model. Empty: the best installed code model."
                },
                "prismify.explainLevel": {
                    "type": "string",
                    "default": "production",
                    "enum": [
                        "production",
                        "pr-review",
                        "beginner"
                    ],
                    "description": "Detail level for doc comments."
                },
                "prismify.formatOnSave": {
                    "type": "boolean",
                    "default": false,
                    "description": "Format (without renaming) when you save."
                }
            }
        },
        "menus": {
            "editor/context": [
                {
                    "command": "prismify.beautify",
                    "when": "editorLangId =~ /^(javascript|javascriptreact|typescript|typescriptreact|python|java)$/",
                    "group": "1_modification@90"
                },
                {
                    "command": "prismify.analyze",
                    "when": "editorLangId =~ /^(javascript|javascriptreact|typescript|typescriptreact|python|java)$/",
                    "group": "1_modification@91"
                }
            ],
            "commandPalette": [
                {
                    "command": "prismify.beautify",
                    "when": "editorLangId =~ /^(javascript|javascriptreact|typescript|typescriptreact|python|java)$/"
                },
                {
                    "command": "prismify.format",
                    "when": "editorLangId =~ /^(javascript|javascriptreact|typescript|typescriptreact|python|java)$/"
                },
                {
                    "command": "prismify.explain",
                    "when": "editorLangId =~ /^(javascript|javascriptreact|typescript|typescriptreact|python|java)$/"
                },
                {
                    "command": "prismify.analyze",
                    "when": "editorLangId =~ /^(javascript|javascriptreact|typescript|typescriptreact|python|java)$/"
                }
            ]
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./"
    },
    "devDependencies": {
        "@types/vscode": "^1.80.0",
        "@types/node": "^20.0.0",
        "typescript": "^5.6.0"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/pronzzz/prismify.git",
        "directory": "vscode-extension"
    }
}
